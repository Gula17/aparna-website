{
  "trailingSlash": true,
  "redirects": [
    { "source": "/products/electric-irons/new-white-blue/", "destination": "/products/electric-irons/passion/", "permanent": true },
    { "source": "/products/electric-irons/new-white-grey/", "destination": "/products/electric-irons/verna/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
